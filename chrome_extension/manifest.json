{
  "manifest_version": 3,
  "name": "Q&Amatomer Launcher",
  "description": "Q&Amatomer をサイドモード／フルモードで操作する",
  "version": "0.5.0",
  "action": {
    "default_title": "Q&Amatomer",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "tabs",
    "windows",
    "system.display"
  ],
  "commands": {
    "toggle-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "MacCtrl+Shift+Q"
      },
      "description": "サイドモード / フルモード 切り替え"
    }
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
